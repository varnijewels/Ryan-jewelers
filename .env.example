
# Config::Litekart
PUBLIC_LITEKART_API_URL='https://api.litekart.in'
PUBLIC_LITEKART_DOMAIN="arialshop.com"
PUBLIC_SITEMAP_URL='https://pub-3.r2.dev'
PUBLIC_STOREFRONT_THEME='default'

# Persistent most-clicked product tracking (Upstash/Vercel Redis REST)
# Private values: configure these on the storefront hosting platform, never PUBLIC_*.
# Use the REST URL and a read/write REST token; restart/redeploy after changing them.
UPSTASH_REDIS_REST_URL='https://your-database.upstash.io'
UPSTASH_REDIS_REST_TOKEN='your-upstash-rest-token'
# Alternative ONLY for one self-hosted Node process with a persistent writable disk:
# POPULARITY_DATA_FILE='/var/lib/ryan-jewels/product-popularity.json'
# Do not use a /tmp path in production or this file option on serverless/multi-instance hosts.

# Ryan Jewels checkout email OTP (private server values)
CHECKOUT_OTP_SECRET='generate-a-long-random-secret'
SMTP_HOST='smtp.gmail.com'
SMTP_PORT='465'
SMTP_SECURE='true'
SMTP_USER='orders@your-domain.com'
SMTP_PASS='your-email-app-password'
SMTP_FROM='Ryan Jewels <orders@your-domain.com>'

# Ryan Jewelers Instagram Professional account (private server values)
INSTAGRAM_ACCESS_TOKEN='your-instagram-user-access-token'

